<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.cognizant</groupId>
    <artifactId>kyc-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kyc-service</name>
    <description>KYC Service for Digital Wallet System</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Springdoc version MUST match the Spring Boot major version in use.
            Spring Boot 3.4.x uses Spring Framework 6.2.x — Springdoc 2.3.0 was
            built for Spring Boot 3.0-3.2 and crashes on the new MVC internals
            (NoSuchMethodError / NullPointerException inside the /v3/api-docs scanner).

            Compatibility matrix:
              Spring Boot 3.0.x – 3.2.x  →  springdoc 2.3.x
              Spring Boot 3.3.x           →  springdoc 2.5.x
              Spring Boot 3.4.x           →  springdoc 2.7.x  ← we are here
        -->
        <springdoc.version>2.7.0</springdoc.version>
        <!--
            Spring Cloud version aligned with Spring Boot 3.4.x
            Uncomment <dependencyManagement> block below when integrating with Eureka.
        -->
        <spring-cloud.version>2024.0.0</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ═══════════════════════════════════ CORE ═══════════════════════════════════ -->

        <!-- Spring Boot Web (WebMVC — Servlet stack) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Bean Validation (@Valid, @NotNull, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenFeign — declarative HTTP client used by UserServiceClient -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- ══════════════════════════════════ DATABASE ════════════════════════════════ -->

        <!-- MySQL Driver (runtime only) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 in-memory DB — tests only -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ════════════════════════════════ DOCUMENTATION ════════════════════════════ -->

        <!-- Springdoc OpenAPI / Swagger UI (WebMVC flavour) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ════════════════════════════════ OBSERVABILITY ════════════════════════════ -->

        <!--
            Spring Boot Actuator — exposes /actuator/health, /actuator/info etc.
            Required by Eureka for health-check registration.
            Safe to include now — it only activates health endpoints with no side-effects.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ═══════════════════════════ CLOUD / SERVICE DISCOVERY ═════════════════════
             INTEGRATOR STEP 2:
             Uncomment the two dependencies below when integrating with Eureka Server.
             Also un-comment the @EnableDiscoveryClient annotation in KycServiceApplication.java
             and update app.user-service.base-url → lb://user-service in application.yml
        ══════════════════════════════════════════════════════════════════════════════ -->


        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>


        <!-- ════════════════════════════════ UTILITIES ════════════════════════════════ -->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ═════════════════════════════════ TESTING ═════════════════════════════════ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
